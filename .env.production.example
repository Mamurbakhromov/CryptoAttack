# =====================================================================
# PRODUCTION env shabloni — signal.saraftech.com (188.245.185.218)
# VM da bu faylni `.env` deb nusxalang va qiymatlarni to'ldiring:
#   cp .env.production.example .env
# .env hech qachon git'ga tushmaydi (.gitignore'da bor).
# =====================================================================

# --- CryptoAttack manbasi (HAQIQIY kalit) ---------------------------
# Productionда mock O'CHIQ, haqiqiy WSS manbaga ulanadi.
MOCK_CRYPTOATTACK=false
CRYPTOATTACK_API_KEY=CryptoAttack-REAL-KEY-BU-YERGA
CRYPTOATTACK_MAIN_URL=https://wss.cryptoattack.net
CRYPTOATTACK_FAST_URL=https://wss2.cryptoattack.net
CRYPTOATTACK_RESUBSCRIBE_INTERVAL_MS=120000
CRYPTOATTACK_SUBSCRIBE_EXTRAS={}

# --- Server (faqat localhost; tashqaridan nginx orqali) -------------
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
# Brauzer dashboard'ni shu origin'dan ochadi (CORS).
WEB_ORIGIN=https://signal.saraftech.com

# --- Dashboard auth ---------------------------------------------------
# Himoya nginx HTTP Basic Auth darajasida (.htpasswd) — pastdagi DEPLOY.md ga qarang.
# Shu sababli app ichidagi token auth O'CHIQ (token JS bundle'ga oshkor bo'lmasligi uchun).
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_AUTH_TOKEN=

# --- Xom event logi ---------------------------------------------------
LOG_RAW_EVENTS=true
RAW_EVENT_LOG_PATH=./data/raw-events.ndjson
REPLAY_RAW_EVENTS_ON_START=
EVENT_BUFFER_SIZE=500
DEDUPE_TTL_MS=86400000
ENABLE_DELISTINGS=true
ENABLE_ANNOUNCEMENT_DELISTING_FALLBACK=false

# --- Exchange symbol cache -------------------------------------------
EXCHANGE_SYMBOL_CACHE_ENABLED=true
EXCHANGE_SYMBOL_CACHE_PATH=./data/exchange-symbols.json
EXCHANGE_SYMBOL_REFRESH_UTC_TIME=00:05
EXCHANGE_SYMBOL_REFRESH_TIMEOUT_MS=12000
EXCHANGE_SYMBOL_REFRESH_ON_START=true

# --- Postgres / TimescaleDB (docker compose orqali) ------------------
# MUHIM: POSTGRES_PASSWORD ni uzun random qiymatga o'zgartiring va
# DATABASE_URL ichidagi parolni ham AYNAN shunday qiling.
POSTGRES_DB=cryptoattack
POSTGRES_USER=cryptoattack
POSTGRES_PASSWORD=CHANGE-ME-uzun-random-parol
POSTGRES_PORT=5432

DATABASE_URL=postgres://cryptoattack:CHANGE-ME-uzun-random-parol@127.0.0.1:5432/cryptoattack
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STORAGE_ENABLED=true
# Migratsiyalar startda EMAS — qo'lda/deploy skript orqali yuritiladi.
DATABASE_MIGRATIONS_ON_START=false
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_WRITE_QUEUE_MAX=10000
DATABASE_WRITE_MAX_RETRIES=3
DATABASE_WRITE_RETRY_BASE_MS=250
DATABASE_WRITE_RETRY_MAX_MS=5000
DATABASE_WRITE_DRAIN_TIMEOUT_MS=10000

# --- Retention / Timescale policy ------------------------------------
RAW_EVENTS_RETENTION_DAYS=30
PRICE_TICKS_RETENTION_DAYS=180
SCORE_SNAPSHOTS_RETENTION_DAYS=365
TIMESCALE_COMPRESSION_ENABLED=true

# --- Narx yig'ish va forward returns ---------------------------------
PRICE_COLLECTION_ENABLED=true
PRICE_COLLECTION_INTERVAL_MS=60000
PRICE_COLLECTION_ACTIVE_COIN_TTL_MS=86400000
FORWARD_RETURN_HORIZONS_MINUTES=5,15,60,240,1440

# --- Scores -----------------------------------------------------------
SCORES_ENABLED=true
SCORES_VERSION=rule-v1
SCORES_RECALC_INTERVAL_MS=30000
SCORES_RECOMPUTE_DEBOUNCE_MS=1000
SCORES_WINDOWS_MINUTES=5,15,60,240,1440
SCORES_BATCH_COINS=100
SCORES_MAX_QUEUE_DEPTH=10000
