# Local-only defaults. Change all passwords and tokens before exposing services.
CRYPTOATTACK_API_KEY=
CRYPTOATTACK_MAIN_URL=https://wss.cryptoattack.net
CRYPTOATTACK_FAST_URL=https://wss2.cryptoattack.net
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
WEB_ORIGIN=http://localhost:5173
POSTGRES_DB=cryptoattack
POSTGRES_USER=cryptoattack
POSTGRES_PASSWORD=cryptoattack
POSTGRES_PORT=5432
MOCK_CRYPTOATTACK=true
LOG_RAW_EVENTS=true
REPLAY_RAW_EVENTS_ON_START=
RAW_EVENT_LOG_PATH=./data/raw-events.ndjson
EVENT_BUFFER_SIZE=500
DEDUPE_TTL_MS=86400000
CRYPTOATTACK_RESUBSCRIBE_INTERVAL_MS=120000
ENABLE_DELISTINGS=true
ENABLE_ANNOUNCEMENT_DELISTING_FALLBACK=false
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_AUTH_TOKEN=
MOCK_EVENT_INTERVAL_MS=1000
EXCHANGE_SYMBOL_CACHE_ENABLED=true
EXCHANGE_SYMBOL_CACHE_PATH=./data/exchange-symbols.json
EXCHANGE_SYMBOL_REFRESH_UTC_TIME=00:05
EXCHANGE_SYMBOL_REFRESH_TIMEOUT_MS=12000
EXCHANGE_SYMBOL_REFRESH_ON_START=true
CRYPTOATTACK_SUBSCRIBE_EXTRAS={}
DATABASE_URL=postgres://cryptoattack:cryptoattack@127.0.0.1:5432/cryptoattack
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STORAGE_ENABLED=false
DATABASE_MIGRATIONS_ON_START=false
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_WRITE_QUEUE_MAX=10000
DATABASE_WRITE_MAX_RETRIES=3
DATABASE_WRITE_RETRY_BASE_MS=250
DATABASE_WRITE_RETRY_MAX_MS=5000
DATABASE_WRITE_DRAIN_TIMEOUT_MS=10000
RAW_EVENTS_RETENTION_DAYS=30
PRICE_TICKS_RETENTION_DAYS=180
SCORE_SNAPSHOTS_RETENTION_DAYS=365
TIMESCALE_COMPRESSION_ENABLED=false
PRICE_COLLECTION_ENABLED=false
PRICE_COLLECTION_INTERVAL_MS=60000
PRICE_COLLECTION_ACTIVE_COIN_TTL_MS=86400000
FORWARD_RETURN_HORIZONS_MINUTES=5,15,60,240,1440
SCORES_ENABLED=false
SCORES_VERSION=rule-v1
SCORES_RECALC_INTERVAL_MS=30000
SCORES_RECOMPUTE_DEBOUNCE_MS=1000
SCORES_WINDOWS_MINUTES=5,15,60,240,1440
SCORES_BATCH_COINS=100
SCORES_MAX_QUEUE_DEPTH=10000
