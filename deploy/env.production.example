# Copy to /opt/cryptoattack/current/.env, replace every placeholder, then chmod 600 .env.
NODE_ENV=production

CRYPTOATTACK_API_KEY=replace-with-real-cryptoattack-api-key
CRYPTOATTACK_MAIN_URL=https://wss.cryptoattack.net
CRYPTOATTACK_FAST_URL=https://wss2.cryptoattack.net
MOCK_CRYPTOATTACK=false
CRYPTOATTACK_RESUBSCRIBE_INTERVAL_MS=120000
ENABLE_DELISTINGS=true
ENABLE_ANNOUNCEMENT_DELISTING_FALLBACK=false
CRYPTOATTACK_SUBSCRIBE_EXTRAS={}

SERVER_HOST=127.0.0.1
SERVER_PORT=3001
WEB_ORIGIN=https://cryptoattack.example.com

DASHBOARD_AUTH_ENABLED=true
DASHBOARD_AUTH_TOKEN=replace-with-long-random-dashboard-token
DASHBOARD_ADMIN_TOKEN=replace-with-different-long-random-admin-token

POSTGRES_DB=cryptoattack
POSTGRES_USER=cryptoattack
POSTGRES_PASSWORD=replace-with-long-random-postgres-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://cryptoattack:replace-with-long-random-postgres-password@127.0.0.1:5432/cryptoattack
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STORAGE_ENABLED=true
DATABASE_REQUIRED_ON_START=true
DATABASE_MIGRATIONS_ON_START=false
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_WRITE_QUEUE_MAX=10000
DATABASE_WRITE_MAX_RETRIES=3
DATABASE_WRITE_RETRY_BASE_MS=250
DATABASE_WRITE_RETRY_MAX_MS=5000
DATABASE_WRITE_DRAIN_TIMEOUT_MS=10000

LOG_RAW_EVENTS=true
REPLAY_RAW_EVENTS_ON_START=false
RAW_EVENT_LOG_PATH=/var/lib/cryptoattack/data/raw-events.ndjson
EVENT_BUFFER_SIZE=1000
DEDUPE_TTL_MS=86400000

EXCHANGE_SYMBOL_CACHE_ENABLED=true
EXCHANGE_SYMBOL_CACHE_PATH=/var/lib/cryptoattack/data/exchange-symbols.json
EXCHANGE_SYMBOL_REFRESH_UTC_TIME=00:05
EXCHANGE_SYMBOL_REFRESH_TIMEOUT_MS=12000
EXCHANGE_SYMBOL_REFRESH_ON_START=true

RAW_EVENTS_RETENTION_DAYS=30
TIMESCALE_COMPRESSION_ENABLED=false
